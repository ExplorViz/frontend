resolver ${RESOLVER} valid=30s ipv6=off;
resolver_timeout 5s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  '' $scheme;
}

server {
  listen 80;
  server_name _;

  # Keep the public port for origin checks. Preserve TLS information from an
  # outer reverse proxy; this container should only trust that proxy's headers.
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_read_timeout 300s;
  client_max_body_size 100m;

  # BEGIN code-analyzer
  location /api/analysis {
    set $upstream_code_analyzer ${CODE_ANALYZER_URL};
    proxy_pass $upstream_code_analyzer;

    # SSE settings
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
  }
  # END code-analyzer

  # BEGIN User-Service

  location /user {
    set $upstream_user ${USER_SERV_URL};
    proxy_pass $upstream_user;
  }

  location /token {
    set $upstream_token ${USER_SERV_URL};
    proxy_pass $upstream_token;
  }

  location /snapshot {
    set $upstream_snapshot ${USER_SERV_URL};
    proxy_pass $upstream_snapshot;
  }

  # END User-Service

  # BEGIN trace-service

  location ~ ^/v3/landscapes/[^/]+/(?:communication|timestamps|trace-data|traces)(?:/.*|$) {
    set $upstream_trace ${TRACE_SERV_URL};
    proxy_pass $upstream_trace;
  }

  location ~ ^/v3/landscapes/[^/]+/spans(?:/.*|$) {
    set $upstream_trace ${TRACE_SERV_URL};
    proxy_pass $upstream_trace;
  }

  # END trace-service

  # BEGIN metrics-service

  location ~ ^/v3/landscapes/[^/]+/metrics(?:/.*|$) {
    set $upstream_metrics ${METRICS_SERV_URL};
    proxy_pass $upstream_metrics;
  }

  # END metrics-service

  # BEGIN log-service

  location ~ ^/v3/landscapes/[^/]+/(?:entities/[^/]+/)?logs(?:/.*|$) {
    set $upstream_log ${LOG_SERV_URL};
    proxy_pass $upstream_log;
  }

  location ~ ^/v3/landscapes/[^/]+/log-levels(?:/.*|$) {
    set $upstream_log ${LOG_SERV_URL};
    proxy_pass $upstream_log;
  }

  # END log-service

  # BEGIN landscape-service

  location /v2/code {
    set $upstream_landscape ${LANDSCAPE_SERV_URL};
    proxy_pass $upstream_landscape;
  }

  location /v2/landscapes {
    set $upstream_landscape ${LANDSCAPE_SERV_URL};
    proxy_pass $upstream_landscape;
  }

  location /v3/landscapes {
    set $upstream_landscape ${LANDSCAPE_SERV_URL};
    proxy_pass $upstream_landscape;
  }

  # END landscape-service

  # BEGIN VSCode

  location ~ ^/(?:v2/ide|savepoints)(?:/|$) {
    set $upstream_vscode ${VSCODE_SERV_URL};
    proxy_pass $upstream_vscode;
  }

  # END VSCode

  # BEGIN Chatbot

  location /providers {
    set $upstream_copilot_providers ${COPILOT_SERV_URL};
    proxy_pass $upstream_copilot_providers;
  }

  location /copilot {
    set $upstream_copilot ${COPILOT_SERV_URL};
    proxy_pass $upstream_copilot;
    proxy_buffering off;
    proxy_cache off;
  }

  # END Chatbot

  # BEGIN Keycloak

  location ~ ^/(?:realms|resources)(?:/|$) {
    set $upstream_keycloak ${KEYCLOAK_URL};
    proxy_pass $upstream_keycloak;
  }

  # END Keycloak

  location = /runtime-config.js {
    root /usr/share/nginx/html;
    add_header Cache-Control "no-store";
  }

  location = /index.html {
    root /usr/share/nginx/html;
    add_header Cache-Control "no-cache";
  }

  # BEGIN Frontend

  location / {
    root /usr/share/nginx/html;
    index index.html index.htm;

    try_files $uri $uri/ /index.html;
  }

  # END Frontend
}
