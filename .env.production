# Browser requests use the origin serving the frontend. Backend addresses belong
# in the nginx container environment, never in the compiled JavaScript.
VITE_CODE_ANALYZER_URL=
VITE_LANDSCAPE_SERV_URL=
VITE_TRACE_SERV_URL=
VITE_METRICS_SERV_URL=
VITE_LOG_SERV_URL=
VITE_USER_SERV_URL=
VITE_VSCODE_SERV_URL=
VITE_COPILOT_SERV_URL=
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REDIRECT_URI=
VITE_SHARE_SNAPSHOT_URL=
VITE_GIT_FACADE_SERV_URL=
VITE_COLLAB_SERV_URL=

VITE_KEYCLOAK_REALM=explorviz
VITE_KEYCLOAK_CLIENT_ID=frontend
# Container runtime-config.js overrides this to match backend authentication.
VITE_ENABLE_SKIP_LOGIN=false
VITE_ENABLE_DEV_LOGIN=false
VITE_DEV_USER_SUB=9000
VITE_DEV_USER_NAME=Development User
VITE_DEV_USER_NICKNAME=change-nickname
VITE_DEV_ACCESS_TOKEN=dev-token
VITE_ONLY_SHOW_TOKEN=change-token
VITE_VERSION_TAG=branch-commit
