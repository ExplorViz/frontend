# Same-origin API requests are forwarded by the Vite development proxy.
# These upstream addresses are used by Vite, not by the browser.
CODE_ANALYZER_URL=http://localhost:8078
TRACE_SERV_URL=http://localhost:8081
METRICS_SERV_URL=http://localhost:8082
LOG_SERV_URL=http://localhost:8083
LANDSCAPE_SERV_URL=http://localhost:8085
USER_SERV_URL=http://localhost:8084

# Browser URLs
VITE_CODE_ANALYZER_URL=
VITE_COPILOT_SERV_URL=http://localhost:4300
VITE_GIT_FACADE_SERV_URL=http://localhost:5000
VITE_KEYCLOAK_URL=http://localhost:5657
VITE_TRACE_SERV_URL=
VITE_METRICS_SERV_URL=
VITE_LOG_SERV_URL=
VITE_LANDSCAPE_SERV_URL=
VITE_SHARE_SNAPSHOT_URL=http://localhost:4200/
VITE_USER_SERV_URL=
VITE_VSCODE_SERV_URL=http://localhost:3000

VITE_ONLY_SHOW_TOKEN=change-token
VITE_VERSION_TAG=branch-commit

# KEYCLOAK
VITE_ENABLE_SKIP_LOGIN=true
VITE_ENABLE_DEV_LOGIN=true
VITE_KEYCLOAK_REALM=explorviz
VITE_KEYCLOAK_CLIENT_ID=frontend
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:8080/
VITE_DEV_USER_SUB=9000
VITE_DEV_USER_NAME=Development User
VITE_DEV_USER_NICKNAME=dev-user
VITE_DEV_ACCESS_TOKEN=dev-token
